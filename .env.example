# Clave de la API de Anthropic (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Contraseña del panel de administrador (/admin.html)
ADMIN_PASSWORD=cambia-esta-contraseña

# Opcionales
PORT=3000
# Modelo de Claude a usar para el diagnóstico
CLAUDE_MODEL=claude-opus-5
# Carpeta donde se guardan los archivos subidos y el índice
DATA_DIR=./data
# Tamaño máximo por archivo en MB
MAX_UPLOAD_MB=50
