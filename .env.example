# IA: basta con una de las dos claves.
# Gemini (Google) — tiene capa gratuita: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Claude (Anthropic) — de pago: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Contraseña del panel de administrador (/admin.html)
ADMIN_PASSWORD=cambia-esta-contraseña

# Opcionales
PORT=3000
# Si hay las dos claves, elige cuál usar: gemini o claude
AI_PROVIDER=
# Modelos a usar
GEMINI_MODEL=gemini-flash-latest
CLAUDE_MODEL=claude-opus-5
# Carpeta donde se guardan los archivos subidos y el índice
DATA_DIR=./data
# Tamaño máximo por archivo en MB
MAX_UPLOAD_MB=50
